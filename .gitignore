config.json

# 环境变量
.env

# 本地工作记录（含本机绝对路径与内部笔记）
.workbuddy/

# 系统文件
.DS_Store

# 测试运行时生成的夹具（由 tests/fixtures/generate.ts 按固定种子重建）
tests/.fixtures/
